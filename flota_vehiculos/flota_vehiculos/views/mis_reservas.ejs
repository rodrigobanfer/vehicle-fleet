<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Reservas</title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body class="fade-in">
    
    <!-- Navbar -->
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand" href="/dashboard">
            <img src="/images/logo.png" alt="Logo">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/dashboard"><i class="fas fa-home me-1"></i>Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/vehiculos"><i class="fas fa-car me-1"></i>Vehículos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/mis_reservas"><i class="fas fa-calendar-alt me-1"></i>Mis Reservas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/perfil"><i class="fas fa-user me-1"></i>Perfil</a>
                </li>
                <% if (user.rol === 'admin') { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-cogs me-1"></i>Administración
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/admin/vehiculos"><i class="fas fa-car-side me-2"></i>Gestión Vehículos</a></li>
                        <li><a class="dropdown-item" href="/admin/concesionarios"><i class="fas fa-building me-2"></i>Gestión Concesionarios</a></li>
                        <li><a class="dropdown-item" href="/admin/usuarios"><i class="fas fa-users me-2"></i>Gestión Usuarios</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/admin/cargar_json"><i class="fas fa-file-import me-2"></i>Cargar JSON</a></li>
                        <li><a class="dropdown-item" href="/admin/estadisticas"><i class="fas fa-chart-bar me-2"></i>Estadísticas</a></li>
                    </ul>
                </li>
                <% } %>
                <li class="nav-item">
                    <a class="nav-link text-danger" href="/logout"><i class="fas fa-sign-out-alt me-1"></i>Salir</a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Contenido principal -->
    <div class="container mt-4">
        <!-- Mensajes -->
        <% if (message) { %>
            <div id="registro-exito" class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
            </div>
            <% delete message; %>
        <% } %>
        <% if (message_error) { %>
            <div id="registro-exito" class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= message_error %>
            </div>
            <% delete message_error; %>
        <% } %>

        <!-- Reservas Activas -->
        <h4 class="mb-3">Reservas Activas</h4>
        <% if (reservasActivas.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Vehículo</th>
                            <th>Matrícula</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reservasActivas.forEach(reserva => { %>
                            <tr>
                                <td><%= reserva.marca %> <%= reserva.modelo %></td>
                                <td><%= reserva.matricula %></td>
                                <td><span class="fecha" data-fecha="<%= reserva.fecha_inicio %>"></span></td>
                                <td><span class="fecha" data-fecha="<%= reserva.fecha_fin %>"></span></td>
                                <td><span class="badge bg-success">Activa</span></td>
                                <td>
                                    <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalCancelar-<%= reserva.id_reserva %>">Cancelar</button>
                                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalFinalizar-<%= reserva.id_reserva %>">Finalizar</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="alert alert-info">No tienes reservas activas.</div>
        <% } %>

        <!-- Historial de Reservas -->
        <h4 class="mb-3 mt-5">Historial de Reservas</h4>
        <% if (historialReservas.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="table-secondary">
                        <tr>
                            <th>Vehículo</th>
                            <th>Matrícula</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Estado</th>
                            <th>Km Recorridos</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% historialReservas.forEach(reserva => { %>
                            <tr>
                                <td><%= reserva.marca %> <%= reserva.modelo %></td>
                                <td><%= reserva.matricula %></td>
                                <td><span class="fecha" data-fecha="<%= reserva.fecha_inicio %>"></span></td>
                                <td><span class="fecha" data-fecha="<%= reserva.fecha_fin %>"></span></td>
                                <td>
                                    <span class="badge bg-<%= reserva.estado === 'finalizada' ? 'secondary' : 'danger' %>">
                                        <%= reserva.estado.charAt(0).toUpperCase() + reserva.estado.slice(1) %>
                                    </span>
                                </td>
                                <td><%= reserva.kilometros_recorridos || '-' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="alert alert-info">No tienes historial de reservas.</div>
        <% } %>
    </div>

    <!-- Modales para cancelar reservas -->
    <% reservasActivas.forEach(reserva => { %>
        <div class="modal fade" id="modalCancelar-<%= reserva.id_reserva %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">CANCELAR RESERVA</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Estás seguro de que quieres cancelar la reserva del vehículo <strong><%= reserva.marca %> <%= reserva.modelo %></strong>?</p>
                        <form id="cancelarForm-<%= reserva.id_reserva %>" class="cancelarForm">
                            <input type="hidden" name="id_reserva" value="<%= reserva.id_reserva %>">
                            <button type="submit" class="btn btn-danger">Sí, cancelar</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, volver</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalFinalizar-<%= reserva.id_reserva %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">FINALIZAR RESERVA</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="error-message-finalizar-<%= reserva.id_reserva %>" class="alert alert-danger d-none"></div>
                        <p>Finalizar reserva del vehículo <strong><%= reserva.marca %> <%= reserva.modelo %></strong></p>
                        <form id="finalizarForm-<%= reserva.id_reserva %>" class="finalizarForm">
                            <input type="hidden" name="id_reserva" value="<%= reserva.id_reserva %>">
                            <div class="form-group">
                                <label for="km_<%= reserva.id_reserva %>">Kilómetros recorridos</label>
                                <input type="number" class="form-control" id="km_<%= reserva.id_reserva %>" name="kilometros_recorridos" min="0" required>
                            </div>
                            <div class="form-group mt-2">
                                <label for="incidencias_<%= reserva.id_reserva %>">Incidencias (opcional)</label>
                                <textarea class="form-control" id="incidencias_<%= reserva.id_reserva %>" name="incidencias_reportadas" rows="3"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary mt-3">Finalizar Reserva</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <% }) %>

    <!-- Botón de accesibilidad -->
    <button id="accesibilidadBtn" class="btn btn-primary" onclick="toggleAccesibilidad()">Accesibilidad</button>

    <div id="accesibilidadOptions" class="accesibilidad-options">
        <h3>Opciones de Accesibilidad</h3>
        <div>
            <label for="colorPaleta">Paleta de Colores:</label>
            <select id="colorPaleta" onchange="cambiarPaletaColores()">
                <option value="default">Normal</option>
                <option value="alto-contraste">Alto Contraste</option>
                <option value="daltonismo">Daltonismo</option>
            </select>
        </div>
        <div>
            <label for="tamanoFuente">Tamaño de Fuente:</label>
            <select id="tamanoFuente" onchange="ajustarTamanoFuente()">
                <option value="pequeno">Pequeño (80%)</option>
                <option value="normal" selected>Normal (100%)</option>
                <option value="grande">Grande (120%)</option>
            </select>
        </div>
        <hr>
        <div>
            <strong>Atajos de Teclado:</strong>
            <ul style="font-size: 0.85rem; margin-top: 5px; padding-left: 20px;">
                <li><kbd>Ctrl</kbd>+<kbd>R</kbd> -> Reservar vehículo</li>
                <li><kbd>Ctrl</kbd>+<kbd>H</kbd> -> Mis reservas</li>
                <li><kbd>Ctrl</kbd>+<kbd>D</kbd> -> Dashboard</li>
                <li><kbd>Ctrl</kbd>+<kbd>P</kbd> -> Mi perfil</li>
                <li><kbd>Ctrl</kbd>+<kbd>A</kbd> -> Accesibilidad</li>
            </ul>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-center py-2">
        <p>&copy; 2025 Plataforma de Gestión de Flotas de Vehículos Eléctricos. Todos los derechos reservados.</p>
    </footer>

    <!-- Scripts -->
    <script src="/javascripts/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/main.js"></script>

    <script>
    //Formatear fechas
    document.querySelectorAll('.fecha').forEach(function(element) {
        const fecha = new Date(element.getAttribute('data-fecha'));
        const fechaFormateada = fecha.toLocaleDateString('es-ES', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
        });
        element.textContent = fechaFormateada;
    });

    //Cancelar reserva
    document.querySelectorAll('.cancelarForm').forEach(function(form) {
        form.addEventListener('submit', async function(event) {
            event.preventDefault();
            const formData = new FormData(this);

            const response = await fetch('/cancelarReserva', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();
            if (result.success) {
                window.location.href = result.redirect;
            }
        });
    });

    //Finalizar reserva
    document.querySelectorAll('.finalizarForm').forEach(function(form) {
        form.addEventListener('submit', async function(event) {
            event.preventDefault();
            const formData = new FormData(this);
            const idReserva = formData.get('id_reserva');

            const response = await fetch('/finalizarReserva', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();
            document.getElementById('error-message-finalizar-' + idReserva).classList.add('d-none');

            if (result.success) {
                window.location.href = result.redirect;
            } else {
                document.getElementById('error-message-finalizar-' + idReserva).textContent = result.message_error;
                document.getElementById('error-message-finalizar-' + idReserva).classList.remove('d-none');
            }
        });
    });
    </script>

</body>
</html>