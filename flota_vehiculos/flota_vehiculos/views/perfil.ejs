<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Perfil</title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .perfil-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .perfil-card {
            background: var(--tercer-color);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 20px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .perfil-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        .perfil-avatar {
            width: 80px;
            height: 80px;
            background-color: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
            font-weight: bold;
            margin-right: 20px;
        }
        .perfil-info h2 {
            margin: 0;
            color: #f8fafc;
        }
        .dato-grupo {
            margin-bottom: 20px;
            padding: 15px;
            background: rgba(0,0,0,0.2);
            border-radius: 10px;
        }
        .dato-grupo label {
            font-weight: bold;
            color: var(--primary-color);
            display: block;
            margin-bottom: 5px;
            font-size: 0.85rem;
            text-transform: uppercase;
        }
        .dato-grupo span {
            color: #f8fafc;
            font-size: 1.1rem;
        }
        .estadisticas-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 15px;
        }
        .estadistica-item {
            background: rgba(0,0,0,0.2);
            padding: 20px 15px;
            border-radius: 10px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .estadistica-item .numero {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary-color);
        }
        .estadistica-item .texto {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-top: 5px;
        }
        .section-title {
            color: #f8fafc;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--primary-color);
        }
        hr {
            border-color: rgba(255,255,255,0.1);
        }
    </style>
</head>
<body class="fade-in">
    
    <!-- Navbar unificado -->
    <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand" href="/dashboard">
            <img src="/images/logo.png" alt="Logo">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/dashboard"><i class="fas fa-home me-1"></i>Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/vehiculos"><i class="fas fa-car me-1"></i>Vehículos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/mis_reservas"><i class="fas fa-calendar-alt me-1"></i>Mis Reservas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="/perfil"><i class="fas fa-user me-1"></i>Perfil</a>
                </li>
                <% if (user.rol === 'admin') { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-cogs me-1"></i>Administración
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/admin/vehiculos"><i class="fas fa-car-side me-2"></i>Gestión Vehículos</a></li>
                        <li><a class="dropdown-item" href="/admin/concesionarios"><i class="fas fa-building me-2"></i>Gestión Concesionarios</a></li>
                        <li><a class="dropdown-item" href="/admin/usuarios"><i class="fas fa-users me-2"></i>Gestión Usuarios</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/admin/cargar_json"><i class="fas fa-file-import me-2"></i>Cargar JSON</a></li>
                        <li><a class="dropdown-item" href="/admin/estadisticas"><i class="fas fa-chart-bar me-2"></i>Estadísticas</a></li>
                    </ul>
                </li>
                <% } %>
                <li class="nav-item">
                    <a class="nav-link text-danger" href="/logout"><i class="fas fa-sign-out-alt me-1"></i>Salir</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container perfil-container mt-4">
        <!-- Mensajes -->
        <% if (message) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
            </div>
        <% } %>
        <% if (message_error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= message_error %>
            </div>
        <% } %>

        <!-- Información del perfil -->
        <div class="perfil-card">
            <div class="perfil-header">
                <div class="perfil-avatar">
                    <%= user.nombre.charAt(0).toUpperCase() %>
                </div>
                <div class="perfil-info">
                    <h2><%= user.nombre %></h2>
                    <span class="badge bg-<%= user.rol === 'admin' ? 'danger' : 'primary' %> mt-2">
                        <i class="fas fa-<%= user.rol === 'admin' ? 'shield-alt' : 'user' %> me-1"></i>
                        <%= user.rol.charAt(0).toUpperCase() + user.rol.slice(1) %>
                    </span>
                </div>
            </div>

            <hr>

            <div class="row">
                <div class="col-md-6">
                    <div class="dato-grupo">
                        <label><i class="fas fa-envelope me-1"></i>Correo electrónico</label>
                        <span><%= user.correo %></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="dato-grupo">
                        <label><i class="fas fa-phone me-1"></i>Teléfono</label>
                        <span><%= user.telefono || 'No especificado' %></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="dato-grupo">
                        <label><i class="fas fa-building me-1"></i>Concesionario</label>
                        <span><%= concesionario ? concesionario.nombre : 'No asignado' %></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="dato-grupo">
                        <label><i class="fas fa-map-marker-alt me-1"></i>Ciudad</label>
                        <span><%= concesionario ? concesionario.ciudad : 'No especificada' %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estadísticas del usuario -->
        <div class="perfil-card">
            <h4 class="section-title"><i class="fas fa-chart-pie me-2"></i>Mis Estadísticas</h4>
            <div class="estadisticas-grid">
                <div class="estadistica-item">
                    <div class="numero"><%= estadisticas.total_reservas || 0 %></div>
                    <div class="texto">Reservas Totales</div>
                </div>
                <div class="estadistica-item">
                    <div class="numero"><%= estadisticas.reservas_activas || 0 %></div>
                    <div class="texto">Activas</div>
                </div>
                <div class="estadistica-item">
                    <div class="numero"><%= estadisticas.reservas_finalizadas || 0 %></div>
                    <div class="texto">Finalizadas</div>
                </div>
                <div class="estadistica-item">
                    <div class="numero"><%= estadisticas.reservas_canceladas || 0 %></div>
                    <div class="texto">Canceladas</div>
                </div>
                <div class="estadistica-item">
                    <div class="numero"><%= estadisticas.km_totales || 0 %></div>
                    <div class="texto">Km Recorridos</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Botón de accesibilidad -->
    <button id="accesibilidadBtn" class="btn btn-primary" onclick="toggleAccesibilidad()">Accesibilidad</button>
    <div id="accesibilidadOptions" class="accesibilidad-options">
        <h3>Opciones de Accesibilidad</h3>
        <div>
            <label for="colorPaleta">Paleta de Colores:</label>
            <select id="colorPaleta" onchange="cambiarPaletaColores()">
                <option value="default">Normal</option>
                <option value="alto-contraste">Alto Contraste</option>
                <option value="daltonismo">Daltonismo</option>
            </select>
        </div>
        <div>
            <label for="tamanoFuente">Tamaño de Fuente:</label>
            <select id="tamanoFuente" onchange="ajustarTamanoFuente()">
                <option value="pequeno">Pequeño (80%)</option>
                <option value="normal" selected>Normal (100%)</option>
                <option value="grande">Grande (120%)</option>
            </select>
        </div>
        <hr>
        <div>
            <strong>Atajos de Teclado:</strong>
            <ul style="font-size: 0.85rem; margin-top: 5px; padding-left: 20px;">
                <li><kbd>Ctrl</kbd>+<kbd>R</kbd> → Reservar vehículo</li>
                <li><kbd>Ctrl</kbd>+<kbd>H</kbd> → Mis reservas</li>
                <li><kbd>Ctrl</kbd>+<kbd>D</kbd> → Dashboard</li>
                <li><kbd>Ctrl</kbd>+<kbd>P</kbd> → Mi perfil</li>
                <li><kbd>Ctrl</kbd>+<kbd>A</kbd> → Accesibilidad</li>
            </ul>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-center py-3 mt-4">
        <p>&copy; 2025 Plataforma de Gestión de Flotas de Vehículos Eléctricos</p>
    </footer>

    <script src="/javascripts/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/main.js"></script>
</body>
</html>