<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estadísticas - Admin</title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .stat-card {
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }
        .stat-card:hover {
            transform: translateY(-5px);
        }
        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
        }
        .stat-icon {
            font-size: 3rem;
            opacity: 0.3;
            position: absolute;
            right: 20px;
            top: 20px;
        }
        .table-estadisticas th {
            background-color: var(--tercer-color);
            color: white;
        }
        .ranking-badge {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 10px;
        }
        .ranking-1 { background-color: gold; color: #333; }
        .ranking-2 { background-color: silver; color: #333; }
        .ranking-3 { background-color: #cd7f32; color: white; }
        .progress-bar-custom {
            height: 25px;
            border-radius: 5px;
        }
    </style>
</head>
<body class="fade-in">
    
   <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand" href="/dashboard">
            <img src="/images/logo.png" alt="Logo">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/dashboard"><i class="fas fa-home me-1"></i>Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/vehiculos"><i class="fas fa-car me-1"></i>Vehículos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/mis_reservas"><i class="fas fa-calendar-alt me-1"></i>Mis Reservas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/perfil"><i class="fas fa-user me-1"></i>Perfil</a>
                </li>
                <% if (user.rol === 'admin') { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-cogs me-1"></i>Administración
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/admin/vehiculos"><i class="fas fa-car-side me-2"></i>Gestión Vehículos</a></li>
                        <li><a class="dropdown-item" href="/admin/concesionarios"><i class="fas fa-building me-2"></i>Gestión Concesionarios</a></li>
                        <li><a class="dropdown-item" href="/admin/usuarios"><i class="fas fa-users me-2"></i>Gestión Usuarios</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/admin/cargar_json"><i class="fas fa-file-import me-2"></i>Cargar JSON</a></li>
                        <li><a class="dropdown-item" href="/admin/estadisticas"><i class="fas fa-chart-bar me-2"></i>Estadísticas</a></li>
                    </ul>
                </li>
                <% } %>
                <li class="nav-item">
                    <a class="nav-link text-danger" href="/logout"><i class="fas fa-sign-out-alt me-1"></i>Salir</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container mt-4">
        
        <!-- Mensaje de éxito/error -->
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
            </div>
        <% } %>

        <!-- Tarjetas de resumen general -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card stat-card bg-primary text-white position-relative">
                    <div class="card-body">
                        <i class="fas fa-calendar-check stat-icon"></i>
                        <h6>Total Reservas</h6>
                        <p class="stat-number"><%= estadisticas.total_reservas %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card stat-card bg-success text-white position-relative">
                    <div class="card-body">
                        <i class="fas fa-check-circle stat-icon"></i>
                        <h6>Reservas Activas</h6>
                        <p class="stat-number"><%= estadisticas.reservas_activas %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card stat-card bg-info text-white position-relative">
                    <div class="card-body">
                        <i class="fas fa-car stat-icon"></i>
                        <h6>Total Vehículos</h6>
                        <p class="stat-number"><%= estadisticas.total_vehiculos %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card stat-card bg-warning text-dark position-relative">
                    <div class="card-body">
                        <i class="fas fa-users stat-icon"></i>
                        <h6>Total Usuarios</h6>
                        <p class="stat-number"><%= estadisticas.total_usuarios %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Reservas por Concesionario -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-dark text-white">
                        <i class="fas fa-building me-2"></i>Reservas por Concesionario
                    </div>
                    <div class="card-body">
                        <% if (reservas_por_concesionario.length === 0) { %>
                            <p class="text-muted text-center">No hay reservas registradas</p>
                        <% } else { %>
                            <% 
                            const maxReservas = Math.max(...reservas_por_concesionario.map(c => c.total_reservas));
                            reservas_por_concesionario.forEach((conc, index) => { 
                                const porcentaje = maxReservas > 0 ? (conc.total_reservas / maxReservas * 100) : 0;
                            %>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span>
                                            <% if (index < 3) { %>
                                                <span class="ranking-badge ranking-<%= index + 1 %>"><%= index + 1 %></span>
                                            <% } %>
                                            <%= conc.nombre %> (<%= conc.ciudad %>)
                                        </span>
                                        <strong><%= conc.total_reservas %> reservas</strong>
                                    </div>
                                    <div class="progress-bar" data-width="<%= porcentaje %>"></div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Vehículos más usados -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-dark text-white">
                        <i class="fas fa-trophy me-2"></i>Vehículos Más Reservados
                    </div>
                    <div class="card-body">
                        <% if (vehiculos_mas_usados.length === 0) { %>
                            <p class="text-muted text-center">No hay reservas registradas</p>
                        <% } else { %>
                            <table class="table table-hover">
                                <thead class="table-estadisticas">
                                    <tr>
                                        <th>#</th>
                                        <th>Vehículo</th>
                                        <th>Matrícula</th>
                                        <th>Reservas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% vehiculos_mas_usados.forEach((veh, index) => { %>
                                        <tr>
                                            <td>
                                                <% if (index < 3) { %>
                                                    <span class="ranking-badge ranking-<%= index + 1 %>"><%= index + 1 %></span>
                                                <% } else { %>
                                                    <%= index + 1 %>
                                                <% } %>
                                            </td>
                                            <td><strong><%= veh.marca %> <%= veh.modelo %></strong></td>
                                            <td><%= veh.matricula %></td>
                                            <td><span class="badge bg-success"><%= veh.total_reservas %></span></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Usuarios más activos -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-dark text-white">
                        <i class="fas fa-user-check me-2"></i>Usuarios Más Activos
                    </div>
                    <div class="card-body">
                        <% if (usuarios_mas_activos.length === 0) { %>
                            <p class="text-muted text-center">No hay reservas registradas</p>
                        <% } else { %>
                            <table class="table table-hover">
                                <thead class="table-estadisticas">
                                    <tr>
                                        <th>#</th>
                                        <th>Usuario</th>
                                        <th>Concesionario</th>
                                        <th>Reservas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% usuarios_mas_activos.forEach((usr, index) => { %>
                                        <tr>
                                            <td>
                                                <% if (index < 3) { %>
                                                    <span class="ranking-badge ranking-<%= index + 1 %>"><%= index + 1 %></span>
                                                <% } else { %>
                                                    <%= index + 1 %>
                                                <% } %>
                                            </td>
                                            <td><strong><%= usr.nombre %></strong></td>
                                            <td><%= usr.nombre_concesionario || 'N/A' %></td>
                                            <td><span class="badge bg-info"><%= usr.total_reservas %></span></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Estadísticas de estado de vehículos -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-dark text-white">
                        <i class="fas fa-chart-pie me-2"></i>Estado de Vehículos
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="p-3 bg-success bg-opacity-25 rounded">
                                    <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                                    <h4 class="text-success"><%= estadisticas.vehiculos_disponibles %></h4>
                                    <small>Disponibles</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-3 bg-primary bg-opacity-25 rounded">
                                    <i class="fas fa-clock fa-2x text-primary mb-2"></i>
                                    <h4 class="text-primary"><%= estadisticas.vehiculos_reservados %></h4>
                                    <small>Reservados</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-3 bg-warning bg-opacity-25 rounded">
                                    <i class="fas fa-tools fa-2x text-warning mb-2"></i>
                                    <h4 class="text-warning"><%= estadisticas.vehiculos_mantenimiento %></h4>
                                    <small>Mantenimiento</small>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <h6 class="mt-3"><i class="fas fa-road me-2"></i>Kilómetros Totales Recorridos</h6>
                        <p class="stat-number text-center text-primary">
                            <%= estadisticas.km_totales ? estadisticas.km_totales.toLocaleString('es-ES') : 0 %> km
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botón volver -->
        <div class="text-center mb-4">
            <a href="/dashboard" class="btn btn-secondary btn-lg">
                <i class="fas fa-arrow-left me-2"></i>Volver al Dashboard
            </a>
        </div>

    </div>

    <!-- Botón de accesibilidad -->
    <button id="accesibilidadBtn" class="btn btn-primary" onclick="toggleAccesibilidad()">Accesibilidad</button>
    <div id="accesibilidadOptions" class="accesibilidad-options">
        <h3>Opciones de Accesibilidad</h3>
        <div>
            <label for="colorPaleta">Cambio de Paleta de Colores:</label>
            <select id="colorPaleta" onchange="cambiarPaletaColores()">
                <option value="default">Normal</option>
                <option value="alto-contraste">Alto Contraste</option>
                <option value="daltonismo">Daltonismo</option>
            </select>
        </div>
        <div>
            <label for="tamanoFuente">Tamaño de Fuente:</label>
            <input type="range" id="tamanoFuente" min="12" max="24" value="16" onchange="ajustarTamanoFuente()" />
        </div>
    </div>

    <footer class="text-center py-3 mt-4">
        <p>&copy; 2025 Plataforma de Gestión de Flotas de Vehículos Eléctricos</p>
    </footer>

    <script src="/javascripts/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/main.js"></script>
</body>
</html>
