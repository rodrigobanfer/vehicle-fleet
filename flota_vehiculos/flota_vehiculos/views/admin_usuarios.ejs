<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body class="fade-in">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand" href="/dashboard">
            <img src="/images/logo.png" alt="Logo">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/dashboard"><i class="fas fa-home me-1"></i>Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/vehiculos"><i class="fas fa-car me-1"></i>Vehículos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/mis_reservas"><i class="fas fa-calendar-alt me-1"></i>Mis Reservas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/perfil"><i class="fas fa-user me-1"></i>Perfil</a>
                </li>
                <% if (user.rol === 'admin') { %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="fas fa-cogs me-1"></i>Administración
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/admin/vehiculos"><i class="fas fa-car-side me-2"></i>Gestión Vehículos</a></li>
                        <li><a class="dropdown-item" href="/admin/concesionarios"><i class="fas fa-building me-2"></i>Gestión Concesionarios</a></li>
                        <li><a class="dropdown-item active" href="/admin/usuarios"><i class="fas fa-users me-2"></i>Gestión Usuarios</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/admin/cargar_json"><i class="fas fa-file-import me-2"></i>Cargar JSON</a></li>
                        <li><a class="dropdown-item" href="/admin/estadisticas"><i class="fas fa-chart-bar me-2"></i>Estadísticas</a></li>
                    </ul>
                </li>
                <% } %>
                <li class="nav-item">
                    <a class="nav-link text-danger" href="/logout"><i class="fas fa-sign-out-alt me-1"></i>Salir</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container mt-4">
        
        <% if (message) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (message_error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= message_error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="card">
            <div class="card-header" style="background-color: var(--tercer-color); color: white;">
                <h5 class="mb-0">👥 Gestión de Usuarios</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Desde aquí puedes asignar empleados a concesionarios y modificar sus roles.</p>
                
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th>Concesionario</th>
                                <th>Reservas Activas</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% usuarios.forEach(usuario => { %>
                                <tr>
                                    <td><%= usuario.id_usuario %></td>
                                    <td><%= usuario.nombre %></td>
                                    <td><%= usuario.correo %></td>
                                    <td>
                                        <% if (usuario.rol === 'admin') { %>
                                            <span class="badge bg-danger">Administrador</span>
                                        <% } else { %>
                                            <span class="badge bg-primary">Empleado</span>
                                        <% } %>
                                    </td>
                                    <td><%= usuario.nombre_concesionario || 'No asignado' %></td>
                                    <td>
                                        <span class="badge bg-info"><%= usuario.reservas_activas %></span>
                                    </td>
                                    <td>
                                        <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalEditar-<%= usuario.id_usuario %>">
                                            ✏️ Editar
                                        </button>
                                    </td>
                                </tr>

                                <!-- Modal Editar Usuario -->
                                <div class="modal fade" id="modalEditar-<%= usuario.id_usuario %>" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Editar Usuario: <%= usuario.nombre %></h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form id="formEditar-<%= usuario.id_usuario %>" class="formEditarUsuario">
                                                <div class="modal-body">
                                                    <input type="hidden" name="id_usuario" value="<%= usuario.id_usuario %>">
                                                    
                                                    <div class="mb-3">
                                                        <label class="form-label"><strong>Nombre:</strong></label>
                                                        <p class="form-control-plaintext"><%= usuario.nombre %></p>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label"><strong>Correo:</strong></label>
                                                        <p class="form-control-plaintext"><%= usuario.correo %></p>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="rol-<%= usuario.id_usuario %>" class="form-label"><strong>Rol:</strong></label>
                                                        <select class="form-select" id="rol-<%= usuario.id_usuario %>" name="rol" required>
                                                            <option value="empleado" <%= usuario.rol === 'empleado' ? 'selected' : '' %>>Empleado</option>
                                                            <option value="admin" <%= usuario.rol === 'admin' ? 'selected' : '' %>>Administrador</option>
                                                        </select>
                                                        <% if (usuario.id_usuario === user.id_usuario) { %>
                                                            <small class="text-warning">⚠️ Este eres tú. No puedes quitarte el rol de admin.</small>
                                                        <% } %>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label for="concesionario-<%= usuario.id_usuario %>" class="form-label"><strong>Concesionario asignado:</strong></label>
                                                        <select class="form-select" id="concesionario-<%= usuario.id_usuario %>" name="id_concesionario" required>
                                                            <% concesionarios.forEach(c => { %>
                                                                <option value="<%= c.id_concesionario %>" <%= usuario.id_concesionario === c.id_concesionario ? 'selected' : '' %>>
                                                                    <%= c.nombre %> (<%= c.ciudad %>)
                                                                </option>
                                                            <% }) %>
                                                        </select>
                                                    </div>

                                                    <div id="error-<%= usuario.id_usuario %>" class="alert alert-danger d-none"></div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-success">Guardar Cambios</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <% if (usuarios.length === 0) { %>
                    <div class="alert alert-info text-center">
                        No hay usuarios registrados.
                    </div>
                <% } %>
            </div>
        </div>

        <div class="mt-3">
            <a href="/dashboard" class="btn btn-secondary">← Volver al Dashboard</a>
        </div>
    </div>

    <!-- Botón de accesibilidad -->
    <button id="accesibilidadBtn" class="btn btn-primary" onclick="toggleAccesibilidad()">Accesibilidad</button>

    <div id="accesibilidadOptions" class="accesibilidad-options">
        <h3>Opciones de Accesibilidad</h3>
        <div>
            <label for="colorPaleta">Paleta de Colores:</label>
            <select id="colorPaleta" onchange="cambiarPaletaColores()">
                <option value="default">Normal</option>
                <option value="alto-contraste">Alto Contraste</option>
                <option value="daltonismo">Daltonismo</option>
            </select>
        </div>
        <div>
            <label for="tamanoFuente">Tamaño de Fuente:</label>
            <select id="tamanoFuente" onchange="ajustarTamanoFuente()">
                <option value="pequeno">Pequeño (80%)</option>
                <option value="normal" selected>Normal (100%)</option>
                <option value="grande">Grande (120%)</option>
            </select>
        </div>
        <hr>
        <div>
            <strong>Atajos de Teclado:</strong>
            <ul style="font-size: 0.85rem; margin-top: 5px; padding-left: 20px;">
                <li><kbd>Ctrl</kbd>+<kbd>R</kbd> -> Reservar vehículo</li>
                <li><kbd>Ctrl</kbd>+<kbd>H</kbd> -> Mis reservas</li>
                <li><kbd>Ctrl</kbd>+<kbd>D</kbd> -> Dashboard</li>
                <li><kbd>Ctrl</kbd>+<kbd>P</kbd> -> Mi perfil</li>
                <li><kbd>Ctrl</kbd>+<kbd>A</kbd> -> Accesibilidad</li>
            </ul>
        </div>
    </div>

    <footer class="text-center py-2">
        <p>&copy; 2025 Plataforma de Gestión de Flotas de Vehículos Eléctricos. Todos los derechos reservados.</p>
    </footer>

    <script src="/javascripts/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/main.js"></script>

    <script>
        // Manejar formularios de edición de usuarios
        document.querySelectorAll('.formEditarUsuario').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const formData = new FormData(this);
                const id_usuario = formData.get('id_usuario');
                const errorDiv = document.getElementById('error-' + id_usuario);
                
                fetch('/admin/usuarios/modificar/' + id_usuario, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams(formData).toString()
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = data.redirect;
                    } else {
                        errorDiv.textContent = data.message_error;
                        errorDiv.classList.remove('d-none');
                    }
                })
                .catch(error => {
                    errorDiv.textContent = 'Error al procesar la solicitud';
                    errorDiv.classList.remove('d-none');
                });
            });
        });
    </script>

</body>
</html>
